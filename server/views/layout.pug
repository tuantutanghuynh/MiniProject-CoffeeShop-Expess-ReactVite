doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title ? `${title} - Coffee Shop` : 'Coffee Shop Menu Management'
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css")
    link(rel="stylesheet", href="/stylesheets/style.css")
  body.bg-light
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.shadow-sm.mb-4
      .container
        a.navbar-brand.fw-bold(href="/drinks")
          i.bi.bi-cup-hot-fill.me-2.text-warning
          | Coffee Shop
        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            if accountId
              li.nav-item
                a.nav-link(href="/drinks")
                  i.bi.bi-journal-richtext.me-1
                  | Đồ uống
              li.nav-item
                a.nav-link(href="/categories")
                  i.bi.bi-grid-fill.me-1
                  | Danh mục
          ul.navbar-nav.ms-auto
            if accountId
              li.nav-item.dropdown
                a.nav-link.dropdown-toggle.text-white(href="#", role="button", data-bs-toggle="dropdown")
                  i.bi.bi-person-circle.me-1
                  span.fw-semibold= fullname
                  if role === 'admin'
                    span.badge.bg-danger.ms-2 Admin
                  else
                    span.badge.bg-secondary.ms-2 User
                ul.dropdown-menu.dropdown-menu-end
                  li
                    a.dropdown-item.text-danger(href="/auth/logout")
                      i.bi.bi-box-arrow-right.me-2
                      | Đăng xuất
            else
              li.nav-item
                a.nav-link(href="/auth/login") Đăng nhập
              li.nav-item
                a.nav-link.btn.btn-outline-warning.btn-sm.text-white.ms-2.px-3(href="/auth/register") Đăng ký

    .container.pb-5
      block content

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
