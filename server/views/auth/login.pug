extends ../layout

block content
  .row.justify-content-center
    .col-md-5.col-lg-4
      .card.shadow-sm
        .card-body.p-4
          h3.text-center.fw-bold.mb-4.text-primary Đăng Nhập

          if errors && Array.isArray(errors)
            each err in errors
              .alert.alert-danger.py-2= err.msg

          form(action="/auth/login", method="POST")
            .mb-3
              label.form-label.fw-semibold(for="email") Email
              input#email.form-control(type="email", name="email", value=(values ? values.email : ''), placeholder="name@example.com", required)

            .mb-3
              label.form-label.fw-semibold(for="pwd") Mật khẩu
              input#pwd.form-control(type="password", name="pwd", placeholder="Mật khẩu", required)

            button.btn.btn-primary.w-100.py-2.fw-bold(type="submit") Đăng nhập

          .text-center.mt-3
            span Chưa có tài khoản? 
            a(href="/auth/register") Đăng ký tài khoản
