extends ../layout

block content
  .row.justify-content-center
    .col-md-7
      .card.shadow-sm
        .card-header.bg-success.text-white.py-3
          h4.card-title.mb-0.fw-bold Thêm Đồ Uống Mới
        .card-body.p-4
          if errors && Array.isArray(errors)
            each err in errors
              .alert.alert-danger.py-2= err.msg

          form(action="/drinks", method="POST", enctype="multipart/form-data")
            .mb-3
              label.form-label.fw-semibold(for="name") Tên đồ uống *
              input#name.form-control(type="text", name="name", value=(drink ? drink.name : ''), placeholder="Ví dụ: Cà phê sữa đá, Trà đào...", required)

            .row
              .col-md-6.mb-3
                label.form-label.fw-semibold(for="price") Giá tiền (VNĐ) *
                input#price.form-control(type="number", name="price", value=(drink ? drink.price : ''), placeholder="Ví dụ: 35000", min="0", required)
              .col-md-6.mb-3
                label.form-label.fw-semibold(for="category") Danh mục *
                select#category.form-select(name="category", required)
                  option(value="") -- Chọn danh mục --
                  each cat in categories
                    option(value=cat._id, selected=(drink && drink.category == cat._id.toString()))= cat.name

            .mb-3
              label.form-label.fw-semibold(for="image") Hình ảnh đồ uống
              input#image.form-control(type="file", name="image", accept="image/*")

            .mb-3
              label.form-label.fw-semibold(for="description") Mô tả
              textarea#description.form-control(name="description", rows="3", placeholder="Mô tả về nguyên liệu, hương vị...")= drink ? drink.description : ''

            .d-flex.justify-content-between.align-items-center.mt-4
              a.btn.btn-outline-secondary(href="/drinks") Quay lại
              button.btn.btn-success.px-4(type="submit") Lưu đồ uống
